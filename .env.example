# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB local database or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/user_management

# Generate two different random secrets (at least 32 characters each in production).
# Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Browser origin and URL used for password-reset links
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api

# Optional: Resend password-reset email delivery. Without these, local development
# returns a reset link in the API response instead of sending email.
RESEND_API_KEY=
EMAIL_FROM=

# Paid plan changes are simulated locally. Real production upgrades stay disabled
# until a payment provider and verified webhook flow are integrated.
ALLOW_SIMULATED_BILLING=false

# Admin seeding is explicit: set these before running npm run seed:admin.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_chars
